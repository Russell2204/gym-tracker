# Секрет для подписи JWT-сессий. Обязательно поменяй в проде на длинную случайную строку.
JWT_SECRET=replace-me-with-a-long-random-string

# Turso (libSQL) — нужны только в проде. Локально без них используется файл data/gym.db.
# URL вида libsql://gym-tracker-<org>.turso.io и read-write токен из дашборда Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
